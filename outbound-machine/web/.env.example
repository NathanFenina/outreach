# === Supabase (lecture server-side, sécurisée) ===
# La service_role key se trouve dans Supabase -> Project Settings -> API.
# ⚠️ Server-side uniquement : ne JAMAIS l'exposer au navigateur (pas de préfixe NEXT_PUBLIC_).
SUPABASE_URL=https://bhgsnoybkxldkzkwkbku.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# === Protection par mot de passe (Basic Auth) ===
# Sans ces 2 variables, l'app est ouverte (ok en local, PAS en prod).
BASIC_AUTH_USER=decupler
BASIC_AUTH_PASSWORD=choose-a-strong-password
